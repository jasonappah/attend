{
  "name": "attend",
  "version": "1.1.371",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "build:icon": "tauri icon ./src-tauri/icons/icon.png",
    "build:tauri": "tauri build --debug",
    "build:web": "one build",
    "migrate:gen": "drizzle-kit generate && yarn zero:generate-ts-schema",
    "migrate:run": "drizzle-kit migrate",
    "postinstall": "(one patch || true) && yarn zero:generate-ts-schema",
    "data:reset": "docker compose down --volumes; rm /tmp/attend_replica.db",
    "dev": "one dev",
    "dev:clean": "one dev --clean",
    "dev:tauri": "tauri dev",
    "clean": "one clean",
    "serve": "one serve",
    "typecheck": "tsc --noEmit",
    "zero:prod": "zero-cache --replica-file /mnt/persist/attend_replica.db",
    "zero:dev": "zero-cache-dev --replica-file /tmp/attend_replica.db",
    "zero:generate-ts-schema": "drizzle-zero generate --format --output src/zero/schema.gen.ts --config src/zero/drizzle-zero.config.ts",
    "android": "one run:android",
    "ios": "one run:ios",
    "prebuild:native": "one prebuild"
  },
  "dependencies": {
    "@better-auth/core": "^1.7.6",
