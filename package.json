    "lucide-react-native": "^1.66.0",
    "nanostores": "^1.3.0",
    "node-ical": "^0.20.1",
    "one": "2.13.1",
    "pg": "^8.16.3",
    "pino": "^9.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
