  ],
  "patchedDependencies": {
    "react-native-reanimated@4.7.1": "patches/react-native-reanimated@4.7.1.patch",
    "react-native-keyboard-controller@1.22.5": "patches/react-native-keyboard-controller@1.22.5.patch",
    "drizzle-orm@1.0.0-beta.9-e89174b": "patches/drizzle-orm@1.0.0-beta.9-e89174b.patch"
  }
}
