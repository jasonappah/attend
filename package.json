    "@tamagui/toast": "3.1.9",
    "@tanstack/react-query": "^5.84.2",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.7.0",
    "@tauri-apps/plugin-deep-link": "^2.4.1",
    "@tauri-apps/plugin-fs": "^2.4.1",
    "@tauri-apps/plugin-shell": "^2.3.0",
    "@trpc/client": "^11.4.4",
    "@trpc/react-query": "^11.4.4",
    "@trpc/server": "^11.4.4",
    "better-auth": "^1.7.6",
