{
  "name": "attend",
  "version": "1.1.371",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "build:icon": "tauri icon ./src-tauri/icons/icon.png",
    "build:tauri": "tauri build --debug",
    "build:web": "one build",
    "migrate:gen": "drizzle-kit generate && yarn zero:generate-ts-schema",
    "migrate:run": "drizzle-kit migrate",
    "postinstall": "yarn zero:generate-ts-schema",
    "data:reset": "docker compose down --volumes; rm /tmp/attend_replica.db",
    "dev": "one dev",
    "dev:clean": "one dev --clean",
    "dev:tauri": "tauri dev",
    "serve": "one serve",
    "zero:prod": "zero-cache --schema-file ./src/zero/zero-schema.json --replica-file /mnt/persist/attend_replica.db",
    "zero:dev": "zero-cache-dev -p ./src/zero/schema.ts --replica-file /tmp/attend_replica.db",
    "zero:generate-ts-schema": "drizzle-zero generate --format --output src/zero/schema.gen.ts",
    "zero:build-schema": "cd ./src/zero && zero-build-schema -p './schema.ts'",
    "android": "one run:android",
    "ios": "one run:ios",
    "prebuild:native": "one prebuild"
  },
  "dependencies": {
    "@react-navigation/core": "^7.12.4",
    "@react-navigation/elements": "^2.6.2",
    "@react-navigation/native": "^7.1.17",
    "@rocicorp/zero": "haha",
    "@t3-oss/env-core": "^0.13.8",
    "@tamagui/config": "^1.132.16",
    "@tamagui/linear-gradient": "^1.132.16",
    "@tamagui/lucide-icons": "^1.132.16",
    "@tamagui/themes": "^1.132.16",
    "@tamagui/toast": "^1.132.16",
    "@tanstack/react-query": "^5.84.2",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "^2.7.0",
    "@tauri-apps/plugin-deep-link": "^2.4.1",
    "@tauri-apps/plugin-fs": "^2.4.1",
    "@tauri-apps/plugin-shell": "^2.3.0",
    "@trpc/client": "^11.4.4",
    "@trpc/react-query": "^11.4.4",
    "@trpc/server": "^11.4.4",
    "@vxrn/better-auth": "^1.1.513",
    "@vxrn/color-scheme": "^1.1.513",
    "@vxrn/emitter": "^1.1.513",
    "better-auth": "^1.3.4",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.4",
    "drizzle-zero": "^0.13.2",
    "expo": "^53.0.20",
    "expo-crypto": "^14.1.5",
    "expo-dev-client": "~5.2.4",
    "expo-linear-gradient": "~14.1.5",
    "expo-sqlite": "^15.2.14",
    "node-ical": "^0.20.1",
    "one": "1.1.513",
    "pg": "^8.16.3",
    "pino": "^9.8.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "^0.79.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "server-only": "^0.0.1",
    "superjson": "^2.2.2",
    "tamagui": "^1.132.16",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@react-native-community/cli": "^19.1.1",
    "@tamagui/vite-plugin": "^1.132.16",
    "@tauri-apps/cli": "^2.7.1",
    "@types/node": "^22.17.1",
    "@types/react": "~19.0.10",
    "drizzle-kit": "^0.31.4",
    "pino-pretty": "^13.1.1",
    "vite": "^7.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "yarn@4.9.2"
}
