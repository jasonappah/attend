    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@biomejs/biome": "2.6.4",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/template": "0.88.0",
    "@react-native/babel-preset": "^0.88.0",
    "@react-native/metro-config": "^0.88.0",
    "@tamagui/vite-plugin": "3.1.9",
    "@types/bun": "^1.4.0",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.23.1",
    "@types/three": "0.184.0",
    "drizzle-kit": "1.0.0-beta.9-e89174b",
    "lefthook": "^2.2.2",
    "pg": "^8.23.1",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "wrangler": "4.114.0"
  },
  "trustedDependencies": [
    "@rocicorp/zero-sqlite3",
