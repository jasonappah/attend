{
  "name": "attend",
  "version": "1.1.377",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.16.0"
  },
  "type": "module",
  "targets": [
    "native",
    "web"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun env.ts -- one dev",
    "android": "one run:android",
    "release:keystore:export": "node -e \"const {execSync} = require('child_process'); const fs = require('fs'); const fields = JSON.parse(execSync('bwbio get fields dff4a4c8-ea83-454d-be4d-b4f700fd7a61', {encoding: 'utf8'})); const b64 = fields.find(f => f.name === 'Keystore (base64)').value; fs.writeFileSync('/tmp/attend-release.keystore', Buffer.from(b64, 'base64')); console.log('Keystore exported to /tmp/attend-release.keystore')\"",
    "release:android": "bash scripts/release-android.sh",
    "ios": "one run:ios",
    "prebuild:native": "one prebuild",
    "build": "NODE_OPTIONS=--import=orez-lite/cloudflare/node-wasm-loader one build",
    "generate": "bun run generate:migrations && bun run generate:local-migrations && bun run generate:types",
    "generate:types": "on-zero generate data",
    "generate:migrations": "drizzle-kit generate --config=database/drizzle.config.ts",
    "generate:local-migrations": "drizzle-kit generate --config=database/localDrizzle.config.ts && bun scripts/generate-local-migrations.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@better-auth/core": "1.6.30",
    "@better-auth/expo": "1.6.30",
    "@callstack/liquid-glass": "^0.8.2",
    "@o/database": "0.16.19-canary.1790679335417",
    "@o/env": "0.16.19-canary.1790679335417",
    "@o/helpers": "0.16.19-canary.1790679335417",
    "@react-native/assets-registry": "0.88.0",
    "@react-navigation/bottom-tabs": "8.0.0-alpha.57",
    "@react-navigation/core": "8.0.0-alpha.41",
    "@react-navigation/elements": "3.0.0-alpha.55",
    "@react-navigation/native": "8.0.0-alpha.51",
    "@react-navigation/native-stack": "8.0.0-alpha.59",
    "@react-three/fiber": "^9.7.0",
    "@rocicorp/zero": "1.9.0",
    "@tamagui/animations-css": "3.1.9",
    "@tamagui/animations-reanimated": "3.1.9",
    "@tamagui/config": "3.1.9",
    "@tamagui/native": "3.1.9",
    "@tamagui/native-registry": "3.1.9",
    "@tamagui/toast": "3.1.9",
    "@tanstack/react-query": "^5.105.1",
    "@trpc/client": "^11.22.1",
    "@trpc/react-query": "^11.22.1",
    "@trpc/server": "^11.22.1",
    "better-auth": "1.6.30",
    "drizzle-orm": "1.0.0-beta.9-e89174b",
    "drizzle-zero-sqlite": "0.16.19-canary.1790679335417",
    "markdown-to-jsx": "^9.10.2",
    "node-ical": "^0.27.3",
    "on-zero": "0.16.19-canary.1790679335417",
    "one": "2.13.1",
    "orez-lite": "0.16.19-canary.1790679335417",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.5",
    "react-native-mmkv": "^3.3.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-purchases": "10.4.3",
    "react-native-reanimated": "4.7.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-teleport": "^1.2.2",
    "react-native-worklets": "~0.13.0",
    "s3mini": "^0.9.5",
    "server-only": "^0.0.1",
    "takeout-better-auth": "file:packages/takeout-better-auth",
    "takeout-mdx": "file:packages/takeout-mdx",
    "takeout-native": "file:packages/takeout-native",
    "takeout-notifications": "file:packages/takeout-notifications",
    "takeout-swipeable": "file:packages/takeout-swipeable",
    "takeout-ui": "file:packages/takeout-ui",
    "tamagui": "3.1.9",
    "three": "0.184.0",
    "typegpu": "0.11.8",
    "uuid": "^14.0.3",
